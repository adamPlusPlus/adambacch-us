{
  "redirects": [
    {
      "source": "/go",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.adambacch.us" }],
      "destination": "https://adambacch.us/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Strict-Transport-Security", "value": "max-age=63072000" }]
    }
  ]
}
